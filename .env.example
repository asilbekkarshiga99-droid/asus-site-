# Осы файлды .env деп көшіріп, мәндерді толтыр.
PORT=3000

# Әкімші: осы email-мен сайтта тіркелген адам /admin.html панеліне кіре алады
ADMIN_EMAIL=admin@example.com

# Kaspi аударымы үшін нөмір мен атың (тапсырыс берушіге көрсетіледі)
KASPI_PHONE=+7 700 000 00 00
KASPI_NAME=Аты Т.

# Нағыз AI-кеңесші (Claude). Кілтті console.anthropic.com сайтынан аласың.
# Кілт тек серверде сақталады, браузерге берілмейді.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Сайт доменің (SEO үшін: canonical, og:image, sitemap)
SITE_URL=https://example.com

# HTTPS арқылы жұмыс істесең 1 деп қой (cookie қауіпсіздігі)
COOKIE_SECURE=0
